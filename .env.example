# ─── Open Cluely environment file ──────────────────────────────────────
# Optional — copy this file to .env and edit values as needed.
# IMPORTANT: .env is a dev-only file. It is not read by packaged builds
# (production settings live in cache/app-state.json under the user-data
# directory), and it is never bundled into installer artifacts.
#
# Do NOT put real API keys in .env or .env.example. Paste API keys into
# the in-app Settings panel instead; they are stored locally in
# cache/app-state.json, which is git-ignored.

# Hide the window from screen capture (Windows/macOS only — a no-op on Linux)
HIDE_FROM_SCREEN_CAPTURE=true

# Start hidden on launch (true / false)
START_HIDDEN=false

# Stealth screenshots to keep (oldest are auto-deleted)
MAX_SCREENSHOTS=50

# Delay (ms) before taking a stealth screenshot
SCREENSHOT_DELAY=300

# Override the Node environment label for the app (defaults to production
# in packaged builds, development otherwise)
# NODE_ENV=development

# Extra flags passed to the embedded Node runtime
# NODE_OPTIONS=

# Point the bundled Vosk speech-to-text server at a custom host
# VOSK_SERVER_URL=http://localhost:2700
