{
  "name": "open-cluely",
  "version": "1.0.0",
  "description": "Desktop AI copilot for meetings and interview practice",
  "main": "src/main.js",
  "homepage": "https://github.com/shubhamshnd/Open-Cluely",
  "scripts": {
    "start": "node scripts/run-electron.js",
    "start:hidden": "node scripts/run-electron.js --start-hidden",
    "dev": "node scripts/run-electron.js --enable-logging",
    "test": "node scripts/run-tests.js",
    "build": "node scripts/run-build.js",
    "build:win": "node scripts/run-build.js --win portable",
    "build:mac": "node scripts/run-build.js --mac",
    "build:linux": "node scripts/run-build.js --linux"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@aws-sdk/client-bedrock": "3.967.0",
    "@aws-sdk/client-bedrock-runtime": "3.967.0",
    "@aws-sdk/client-transcribe": "3.967.0",
    "@aws-sdk/client-transcribe-streaming": "3.967.0",
    "@aws-sdk/credential-providers": "3.967.0",
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^16.3.1",
    "openai": "6.49.0",
    "screenshot-desktop": "^1.15.0",
    "tesseract.js": "^6.0.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.25.6"
  },
  "build": {
    "appId": "com.opencluely.app",
    "productName": "Open Cluely",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!.git/**/*",
      "!dist/**/*"
    ],
    "asarUnpack": [
      "node_modules/screenshot-desktop/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Open Cluely needs microphone access to transcribe your voice during meetings.",
        "NSScreenCaptureUsageDescription": "Open Cluely needs screen recording access to capture screenshots and host audio for transcription."
      }
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "verifyUpdateCodeSignature": false,
      "fileAssociations": []
    },
    "portable": {
      "artifactName": "OpenCluely.exe"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "category": "Utility",
      "maintainer": "Open Cluely"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "category": "Utility",
      "packageCategory": "utils",
      "maintainer": "Open Cluely",
      "synopsis": "Desktop AI copilot for meetings and interview practice",
      "description": "Desktop AI copilot for meetings and interview practice: transcribes host and microphone audio, captures screenshots, and answers with configurable AI providers.",
      "desktop": {
        "Name": "Open Cluely",
        "GenericName": "AI Meeting Copilot",
        "Comment": "Desktop AI copilot for meetings and interview practice",
        "Icon": "open-cluely",
        "StartupWMClass": "open-cluely",
        "Categories": "Utility;"
      }
    }
  },
  "author": "Shubham",
  "license": "MIT"
}
